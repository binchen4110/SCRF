{
  "dataset": "MKG-W",
  "epochs": 2000,
  "dim": 200,
  "batch_size": 1024,
  "eval_batch_size": 256,
  "eval_every": 100,
  "lr": 0.001,
  "weight_decay": 0.0,
  "seed": 2025,
  "threads": 4,
  "top_k": 500,
  "temperature": 4.0,
  "prediction_temperature": 2.0,
  "kd_weight": 1.0,
  "warmup_epochs": 50,
  "scale_t2": false,
  "supervision": "query_ce",
  "query_smoothing": 0.1,
  "features": "original",
  "no_feature_normalize": false,
  "decoder_dropout": [
    0.3,
    0.4,
    0.5
  ],
  "fusion_norm": "layernorm",
  "no_decoder_batchnorm": false,
  "filter_scope": "all",
  "early_stop_patience": 0,
  "early_stop_split": "valid",
  "ablation": "none",
  "student_input": "gated",
  "candidate_input": "raw",
  "decoder_relation_mode": "shared",
  "selection_split": "test",
  "selection_branch": "mean",
  "eval_limit": 0,
  "ensemble_weights": [
    0.25,
    0.25,
    0.25,
    0.25
  ]
}
